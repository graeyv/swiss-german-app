{
  "id": "pronunciation",
  "title": "Aussprache",
  "subtitle": "So klingt Berndeutsch",
  "description": "Entdecke die wichtigsten Unterschiede zwischen der Aussprache im Hochdeutschen und im Berndeutschen.",
  "note": "Wir verwenden hochdeutsche Wörter und sprechen sie mit Berner Aussprache aus. So kannst du dich ganz auf die Laute konzentrieren. Berndeutsch unterscheidet sich aber nicht nur in der Aussprache, sondern auch im Wortschatz und in der Grammatik. Die berndeutschen Wörter und ihre Schreibweise lernst du in späteren Lektionen.",
  "sections": [
    {
      "id": "consonants",
      "title": "Konsonanten",
      "description": "Bei diesen Konsonanten unterscheidet sich die Aussprache vom Hochdeutschen.",
      "rules": [
        {
          "id": "ch",
          "title": "CH",
          "theory": "Im Hochdeutschen gibt es drei verschiedene Arten, den CH-Laut auszusprechen: den Ach-Laut wie in «Bach», den Ich-Laut wie in «Dicht» und den K-Laut wie in «Chaos». Im Berndeutschen wird CH in den entsprechenden Wörtern als Ach-Laut ausgesprochen.",
          "examples": [
            {
              "word": "Bach",
              "pronunciation": {
                "standardGerman": "Ach-Laut",
                "dialect": "Ach-Laut"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            },
            {
              "word": "Dicht",
              "pronunciation": {
                "standardGerman": "Ich-Laut",
                "dialect": "Ach-Laut"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            },
            {
              "word": "Chaos",
              "pronunciation": {
                "standardGerman": "K-Laut",
                "dialect": "Ach-Laut"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            }
          ],
          "takeaway": "CH wird wie in «Bach» ausgesprochen."
        },
        {
          "id": "k-ck",
          "title": "K und CK",
          "theory": "Im Berndeutschen wird K mit einem zusätzlichen rauen Reibelaut gesprochen. Man kann sich das ungefähr wie «K + ch» vorstellen. Das gilt auch für CK.",
          "examples": [
            {
              "word": "Kunst",
              "pronunciation": {
                "standardGerman": "K-Laut",
                "dialect": "K + ch"
              },
              "audio": {
