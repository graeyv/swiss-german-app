{
  "id": "pronunciation",
  "title": "Aussprache",
  "subtitle": "So klingt Berndeutsch",
  "description": "Entdecke die wichtigsten Unterschiede zwischen der Aussprache im Hochdeutschen und im Berndeutschen.",
  "expectations": [
    {
      "icon": "sound",
      "title": "Den Unterschied hören",
      "text": "Dieselben Wörter auf Hochdeutsch und Berndeutsch im direkten Vergleich."
    },
    {
      "icon": "speak",
      "title": "Die Laute selbst sprechen",
      "text": "Mit einfachen Tipps, zum Beispiel für das gerollte R."
