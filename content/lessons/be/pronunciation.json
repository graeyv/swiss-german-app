    {
      "id": "consonants",
      "title": "Konsonanten",
      "description": "Bei diesen Konsonanten unterscheidet sich die Aussprache vom Hochdeutschen.",
      "rules": [
        {
          "id": "ch",
          "title": "CH",
          "theory": "Im Hochdeutschen gibt es drei verschiedene Arten, den CH-Laut auszusprechen: den Ach-Laut wie in «Bach», den Ich-Laut wie in «Dicht» und den K-Laut wie in «Chaos». Im Berndeutschen wird CH meist als Ach-Laut ausgesprochen.",
          "examples": [
            {
              "word": "Bach",
              "pronunciation": {
                "standardGerman": "Ach-Laut",
                "dialect": "Ach-Laut"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            },
            {
              "word": "Dicht",
              "pronunciation": {
                "standardGerman": "Ich-Laut",
                "dialect": "Ach-Laut"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            },
            {
              "word": "Chaos",
              "pronunciation": {
                "standardGerman": "K-Laut",
                "dialect": "Ach-Laut"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            }
          ],
          "takeaway": "CH wird wie in «Bach» ausgesprochen."
        },
        {
          "id": "k-ck",
          "title": "K und CK",
          "theory": "Im Berndeutschen wird K mit einem zusätzlichen rauen Reibelaut gesprochen. Man kann sich das ungefähr wie «K + ch» vorstellen. Das gilt auch für CK.",
          "examples": [
            {
              "word": "Kunst",
              "pronunciation": {
                "standardGerman": "K-Laut",
                "dialect": "K + ch"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            },
            {
              "word": "Dick",
              "pronunciation": {
                "standardGerman": "K-Laut",
                "dialect": "K + ch"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            },
            {
              "word": "Klicken",
              "pronunciation": {
                "standardGerman": "K-Laut",
                "dialect": "K + ch"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            }
          ],
          "takeaway": "Bei K und CK kommt ein leichtes «ch» dazu."
        },
        {
          "id": "r",
          "title": "R",
          "theory": "Im Hochdeutschen wird das R häufig hinten im Rachen gebildet. Am Wortende, zum Beispiel bei «Wasser» oder «Bier», wird es oft nicht als richtiges R gesprochen, sondern klingt eher wie ein kurzer Vokal. Im Berndeutschen wird das R typischerweise mit der Zungenspitze gerollt.",
          "examples": [
            {
              "word": "Wasser",
              "pronunciation": {
                "standardGerman": "Vokalisiertes R am Wortende",
                "dialect": "Gerolltes R"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            },
            {
              "word": "Bier",
