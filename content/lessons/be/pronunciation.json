                "dialect": "K + ch"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            },
            {
              "word": "Klicken",
              "pronunciation": {
                "standardGerman": "K-Laut",
                "dialect": "K + ch"
              },
              "audio": {
                "standardGerman": null,
                "dialect": null
              }
            }
          ],
          "takeaway": "Bei K und CK kommt ein leichtes «ch» dazu."
        },
        {
          "id": "r",
          "title": "R",
          "theory": "Im Hochdeutschen wird das R häufig hinten im Rachen gebildet. Am Wortende, zum Beispiel bei «Wasser» oder «Bier», wird es oft nicht als richtiges R gesprochen, sondern klingt eher wie ein kurzer Vokal. Im Berndeutschen wird das R typischerweise mit der Zungenspitze gerollt.",
          "examples": [
            {
              "word": "Wasser",
              "pronunciation": {
                "standardGerman": "Vokalisiertes R am Wortende",
                "dialect": "Gerolltes R"
