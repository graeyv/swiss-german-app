{
  "id": "sounds",
  "title": "Pronunciation",
  "titleIn": {
    "de": "Aussprache"
  },
  "subtitle": "How Bärndütsch sounds",
  "icon": "speaking",
  "description": "Start with the sounds you already know from English, then those written differently, and finally the ones that are new.",
  "expectations": [
    {
      "icon": "headphones",
      "title": "Hear the sounds of Bärndütsch"
    },
    {
      "icon": "speaking",
      "title": "Say them yourself"
    }
  ],
  "sections": [
    {
      "id": "familiar",
      "title": "Familiar letters, familiar sounds",
      "description": "Vowels and consonants that sound as in English.",
