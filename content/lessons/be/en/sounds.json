    {
      "id": "different-letters",
      "title": "Familiar sounds, different letters",
      "description": "J, W, Z and SCH: familiar sounds, written with other letters.",
      "rules": [
        {
          "id": "introduction",
          "title": "Sounds you know, written differently",
          "theory": "Some letters you know are said differently in Bärndütsch. The sounds themselves are familiar: only the letter that stands for them is new.",
          "examples": []
        },
        {
          "id": "j",
          "title": "J",
          "theory": "In Bärndütsch, J is pronounced like the English Y in [y]es.",
          "sounds": [
            {
              "letter": "J",
              "words": [
                {
                  "word": "Ja",
                  "meaning": "Yes",
                  "audio": "/audio/lessons/be/sounds/ja_be.mp3"
                },
                {
                  "word": "Jahr",
                  "meaning": "Year",
                  "audio": "/audio/lessons/be/sounds/jahr_be.mp3"
                },
                {
                  "word": "Jede",
                  "meaning": "Every",
                  "audio": "/audio/lessons/be/sounds/jede_be.mp3"
                }
              ]
            }
          ],
          "examples": []
        },
        {
          "id": "w",
          "title": "W",
          "theory": "In Bärndütsch, W is pronounced like the English V in [v]ery.",
          "sounds": [
            {
              "letter": "W",
              "words": [
                {
                  "word": "Wasser",
                  "meaning": "Water",
                  "audio": "/audio/lessons/be/sounds/wasser_be.mp3"
                },
                {
                  "word": "Wuche",
                  "meaning": "Week",
                  "audio": "/audio/lessons/be/sounds/wuche_be.mp3"
                },
                {
                  "word": "Winter",
                  "meaning": "Winter",
                  "audio": "/audio/lessons/be/sounds/winter_be.mp3"
                }
              ]
            }
          ],
          "examples": []
        },
        {
          "id": "z",
          "title": "Z",
          "theory": "In Bärndütsch, Z is pronounced like TS in the English words ca[ts] or [Ts]unami.",
          "sounds": [
            {
              "letter": "Z",
              "words": [
                {
                  "word": "Ziit",
                  "meaning": "Time",
                  "audio": "/audio/lessons/be/sounds/ziit_be.mp3"
                },
                {
                  "word": "Znacht",
                  "meaning": "Dinner",
                  "audio": "/audio/lessons/be/sounds/znacht_be.mp3"
                },
                {
                  "word": "Züri",
                  "meaning": "Zurich",
                  "audio": "/audio/lessons/be/sounds/zueri_be.mp3"
                }
              ]
            }
          ],
          "examples": []
        },
        {
          "id": "sch",
          "title": "SCH",
          "theory": "The combination SCH is pronounced like the English SH in [sh]oe.",
          "sounds": [
            {
              "letter": "SCH",
              "words": [
                {
                  "word": "Schoggi",
                  "meaning": "Chocolate",
                  "audio": "/audio/lessons/be/sounds/schoggi_be.mp3"
                },
                {
                  "word": "Schiff",
                  "meaning": "Ship",
                  "audio": "/audio/lessons/be/sounds/schiff_be.mp3"
                },
                {
                  "word": "Schueh",
                  "meaning": "Shoes",
                  "audio": "/audio/lessons/be/sounds/schueh_be.mp3"
                }
              ]
