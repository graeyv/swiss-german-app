    {
      "id": "new-sounds",
      "title": "New sounds or new letters",
      "description": "R, Ä, Ö, Ü, CH, K, ST and SP: sounds or letters English doesn't have.",
      "rules": [
        {
          "id": "introduction",
          "title": "Something new",
          "theory": "Now it gets new: sounds English doesn't have, such as CH and R, and letters it doesn't have, such as Ä, Ö and Ü. They take a little more practice.",
          "examples": []
        },
        {
          "id": "r",
          "title": "R",
          "theory": "In Bärndütsch, R is rolled with the tip of the tongue, quite unlike the English R.",
          "sounds": [
            {
              "letter": "R",
              "words": [
                {
                  "word": "Rot",
                  "meaning": "Red",
                  "audio": "/audio/lessons/be/sounds/rot_be.mp3"
                },
                {
                  "word": "Räge",
                  "meaning": "Rain",
                  "audio": "/audio/lessons/be/sounds/raege_be.mp3"
                },
                {
                  "word": "Richtig",
                  "meaning": "Correct",
                  "audio": "/audio/lessons/be/sounds/richtig_be.mp3"
                }
              ]
            }
          ],
          "examples": [],
          "tip": "If you speak Spanish or Italian, you can try the rolled R as a starting point, as in Italian [r]osso or Spanish pe[rr]o."
        },
        {
          "id": "ae",
          "title": "Ä",
          "theory": "In Bärndütsch, Ä is a very open vowel, close to the a in c[a]t or b[a]t as said in British English.",
          "sounds": [
            {
              "letter": "Ä",
              "words": [
                {
                  "word": "Mässer",
                  "meaning": "Knife",
                  "audio": "/audio/lessons/be/sounds/maesser_be.mp3"
                },
                {
                  "word": "Bär",
                  "meaning": "Bear",
                  "audio": "/audio/lessons/be/sounds/baer_be.mp3"
                },
                {
                  "word": "Stärn",
                  "meaning": "Star",
                  "audio": "/audio/lessons/be/sounds/staern_be.mp3"
                }
              ]
            }
          ],
          "examples": []
        },
        {
          "id": "oe",
          "title": "Ö",
          "theory": "Ö doesn't exist in English, but it's close to the vowel in b[ir]d or h[er] in British English.",
          "sounds": [
            {
              "letter": "Ö",
              "words": [
                {
                  "word": "Schön",
                  "meaning": "Beautiful",
                  "audio": "/audio/lessons/be/sounds/schoen_be.mp3"
                },
                {
                  "word": "Löffu",
                  "meaning": "Spoon",
                  "audio": "/audio/lessons/be/sounds/loeffu_be.mp3"
                },
                {
                  "word": "Öffne",
                  "meaning": "Open",
                  "audio": "/audio/lessons/be/sounds/oeffne_be.mp3"
                }
              ]
            }
          ],
          "examples": []
        },
        {
          "id": "ue",
          "title": "Ü",
          "theory": "Ü doesn't exist in English either. Say a long ee as in s[ee], and while you keep saying it, push your lips forward into a small circle, as if you were about to whistle.",
          "sounds": [
            {
              "letter": "Ü",
              "words": [
                {
                  "word": "Tür",
                  "meaning": "Door",
                  "audio": "/audio/lessons/be/sounds/tuer_be.mp3"
                },
                {
                  "word": "Müed",
                  "meaning": "Tired",
                  "audio": "/audio/lessons/be/sounds/mueed_be.mp3"
                },
                {
                  "word": "Nüt",
                  "meaning": "Nothing",
                  "audio": "/audio/lessons/be/sounds/nuet_be.mp3"
                }
              ]
            }
          ],
          "examples": [],
          "tip": "If you know French: Ü sounds like the u in t[u]."
        },
        {
          "id": "ch",
          "title": "CH",
          "theory": "CH is one of the most typical sounds of Bärndütsch: a strong, breathy sound made at the back of the mouth, a bit like gently clearing your throat.",
          "sounds": [
            {
              "letter": "CH",
              "words": [
                {
                  "word": "Chind",
                  "meaning": "Child",
                  "audio": "/audio/lessons/be/sounds/chind_be.mp3"
                },
                {
                  "word": "Dach",
                  "meaning": "Roof",
                  "audio": "/audio/lessons/be/sounds/dach_be.mp3"
                },
                {
                  "word": "Buech",
                  "meaning": "Book",
                  "audio": "/audio/lessons/be/sounds/buech_be.mp3"
                }
              ]
            }
          ],
          "examples": [],
          "tip": "If you know Spanish, CH is like the j in [J]osé. The French r in [r]ouge comes close too."
        },
        {
          "id": "k",
          "title": "K",
          "theory": "In Bärndütsch, K is followed by a short CH, the breathy sound from the topic before. So Kiosk sounds almost like “kchiosk”.",
          "sounds": [
            {
              "letter": "K",
              "words": [
                {
                  "word": "Knapp",
                  "meaning": "Close",
                  "audio": "/audio/lessons/be/sounds/knapp_be.mp3"
                },
                {
                  "word": "Karussell",
                  "meaning": "Carousel",
                  "audio": "/audio/lessons/be/sounds/karussell_be.mp3"
                },
                {
                  "word": "Kiosk",
                  "meaning": "Kiosk",
                  "audio": "/audio/lessons/be/sounds/kiosk_be.mp3"
                }
              ]
            }
          ],
          "examples": []
        },
        {
          "id": "st",
          "title": "ST",
          "theory": "In Bärndütsch, ST is said as SHT, at the start of a word and in the middle too: the sh in [sh]oe, followed by t. Strass sounds like “shtrass”.",
          "sounds": [
            {
              "letter": "ST",
              "words": [
                {
                  "word": "Strass",
                  "meaning": "Street",
                  "audio": "/audio/lessons/be/sounds/strass_be.mp3"
                },
                {
                  "word": "Stäge",
                  "meaning": "Stairs",
                  "audio": "/audio/lessons/be/sounds/staege_be.mp3"
                },
                {
                  "word": "Stadt",
                  "meaning": "City",
                  "audio": "/audio/lessons/be/sounds/stadt_be.mp3"
                }
              ]
            }
          ],
          "examples": []
        },
        {
          "id": "sp",
          "title": "SP",
          "theory": "In Bärndütsch, SP is said as SHP, at the start of a word and in the middle too: the sh in [sh]oe, followed by p. Sport sounds like “shport”.",
          "sounds": [
            {
              "letter": "SP",
              "words": [
                {
                  "word": "Sport",
                  "meaning": "Sport",
                  "audio": "/audio/lessons/be/sounds/sport_be.mp3"
                },
                {
                  "word": "Spiu",
                  "meaning": "Game",
                  "audio": "/audio/lessons/be/sounds/spiu_be.mp3"
                },
                {
                  "word": "Spaghetti",
                  "meaning": "Spaghetti",
                  "audio": "/audio/lessons/be/sounds/spaghetti_be.mp3"
                }
              ]
            }
          ],
          "examples": []
        }
      ],
      "exercises": [
        {
          "id": "ae",
          "type": "sounds_like",
          "letter": "Ä",
          "options": [
            "a in c[a]t, as said in British English",
            "ay in d[ay]"
          ],
          "example": {
            "word": "Bär",
            "meaning": "Bear",
            "audio": "/audio/lessons/be/sounds/baer_be.mp3"
          }
        },
        {
          "id": "oe",
          "type": "sounds_like",
          "letter": "Ö",
          "options": [
            "ir in b[ir]d, as said in British English",
            "oy in b[oy]"
          ],
          "example": {
            "word": "Schön",
            "meaning": "Beautiful",
            "audio": "/audio/lessons/be/sounds/schoen_be.mp3"
          }
        },
        {
          "id": "st",
          "type": "sounds_like",
          "letter": "ST",
