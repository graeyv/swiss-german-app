                  "audio": null
                },
                {
                  "word": "Züri",
                  "meaning": "Zurich",
                  "audio": null
                }
              ]
            }
          ],
          "examples": []
        },
        {
          "id": "sch",
          "title": "SCH",
          "theory": "The combination SCH is pronounced like the English SH in [sh]oe.",
