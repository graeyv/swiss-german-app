{
  "name": "hoi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:push": "supabase db push --include-seed",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "content:build": "node scripts/build-flashcard-seed.mjs",
    "db:content": "npm run content:build && supabase db query --linked -f supabase/seeds/flashcards.sql",
    "dev:reset-progress": "node scripts/reset-progress.mjs",
    "dev:time-travel": "node scripts/time-travel.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
